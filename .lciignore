# Agent control-plane material remains available to coding agents without
# competing with product source during code retrieval.
.agents/**
.github/agents/**
.github/instructions/**
.github/skills/**
.codex/**
.claude/**
# Kilo's own control-plane directory. In particular, worktrees/ under it
# holds full nested checkouts of this repository (their own src/, tests/,
# etc.) -- leaving this out would silently double-index this project's own
# source under a second path.
.kilo/**
test-results/**
