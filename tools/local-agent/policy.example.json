{
  "schema": "local-agent.policy/v1",
  "repositoryRoot": "../..",
  "read": [
    "AGENTS.md",
    "README.md",
    "Cargo.toml",
    "config.example.toml",
    "docs/**",
    "scripts/**",
    "src/**",
    "tests/**",
    "tools/local-agent/**"
  ],
  "write": [
    "tools/local-agent/**"
  ],
  "deny": [
    ".agents/skills/rust-skills/**",
    ".git/**",
    "Cargo.lock",
    "target/**",
    "test-results/**"
  ],
  "model": {
    "name": "qwen3.8-27b",
    "endpoint": "http://127.0.0.1:8765/v1",
    "apiKeyEnv": "QWEN_API_KEY"
  },
  "lci": {
    "endpoint": "http://127.0.0.1:8768/mcp"
  },
  "limits": {
    "maxTurns": 24,
    "maxReadLines": 400,
    "maxPatchBytes": 24576,
    "maxToolResultBytes": 16384,
    "modelRequestTimeoutMs": 600000,
    "mcpRequestTimeoutMs": 60000,
    "checkTimeoutMs": 600000,
    "gitTimeoutMs": 60000,
    "taskDeadlineMs": 1800000,
    "retryBudget": {
      "model_failure": 1,
      "mcp_failure": 1,
      "patch_rejected": 2,
      "check_failed": 1
    }
  },
  "checks": {
    "script": "scripts/Test.ps1",
    "suites": {
      "chunk": "Chunk",
      "filter": "Filter",
      "evaluation": "Evaluation",
      "indexing": "Indexing",
      "readiness": "Readiness",
      "mcp": "MCP",
      "watching": "Watching",
      "lsp": "LSP",
      "full": "Full"
    },
    "pathRules": [
      { "glob": "src/chunk.rs", "suites": ["chunk", "indexing"], "reason": "chunking and indexing behavior" },
      { "glob": "src/language.rs", "suites": ["chunk", "indexing"], "reason": "language chunking and indexing behavior" },
      { "glob": "src/filter.rs", "suites": ["filter", "evaluation"], "reason": "filtering and evaluation behavior" },
      { "glob": "src/source_role.rs", "suites": ["filter", "evaluation"], "reason": "source role filtering and evaluation" },
      { "glob": "src/lsp.rs", "suites": ["lsp"], "reason": "LSP navigation behavior" },
      { "glob": "src/server.rs", "suites": ["mcp", "readiness"], "reason": "MCP server and readiness behavior" },
      { "glob": "src/request.rs", "suites": ["mcp", "readiness"], "reason": "MCP request handling and readiness" },
      { "glob": "tests/cases/indexing.rs", "suites": ["indexing"], "reason": "indexing test cases" },
      { "glob": "tests/cases/mcp.rs", "suites": ["mcp"], "reason": "MCP test cases" }
    ],
    "finalSuite": "full"
  },
  "audit": {
    "jsonlPath": "test-results/local-agent/audit.jsonl"
  }
}
